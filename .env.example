# Copy to .env and fill in values:
#   cp .env.example .env
#
# Put real secrets in .env only — never commit .env (it is gitignored).

# App
SECRET_KEY=change-me-in-production
HOST=127.0.0.1
PORT=8000

# Auth sessions (OTP sign-in — long-lived)
SESSION_COOKIE_NAME=knowledgetree_session
SESSION_TTL_HOURS=720
SECURE_COOKIES=false

# OTP
OTP_TTL_MINUTES=10

# Resend (same pattern as Pickwise)
RESEND_API_KEY=
EMAIL_FROM=noreply@pickwise.dev
EMAIL_REPLY_TO=

# Database
DATABASE_URL=postgresql://jagannadh@127.0.0.1:5432/knowledgetree
